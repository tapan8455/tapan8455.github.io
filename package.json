{
  "name": "aura-iptv-macos",
  "version": "2.0.0",
  "description": "AURA IPTV — universal IPTV client for macOS, web, and cloud deployment.",
  "main": "main.js",
  "author": "AURA",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "start": "node start.js",
    "serve": "node server.js",
    "web": "node server.js",
    "desktop": "electron .",
    "build": "echo 'AURA IPTV ready'",
    "dist": "electron-builder --mac",
    "dist:arm64": "electron-builder --mac --arm64",
    "dist:x64": "electron-builder --mac --x64",
    "dist:universal": "electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.aura.iptv",
    "productName": "AURA IPTV",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "minimumSystemVersion": "12.0"
    }
  }
}
