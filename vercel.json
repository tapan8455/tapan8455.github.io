{
  "version": 2,
  "public": false,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/request", "destination": "/api/request" },
    { "source": "/api/test-connection", "destination": "/api/test-connection" },
    { "source": "/api/stop-stream", "destination": "/api/stop-stream" },
    { "source": "/stream", "destination": "/api/stream" },
    { "source": "/((?!api/|stream).*)$", "destination": "/src/$1" },
    { "source": "/", "destination": "/src/index.html" }
  ]
}